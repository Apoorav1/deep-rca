# Copy to infra/runtime.env and fill in your own values (that file is gitignored).
# Everything here points ONLY at the evidence lake, state store, and model endpoint.
# Ground-truth configuration (DEEPRCA_GT_ACCOUNT) is used solely by the offline eval plane.

DEEPRCA_EVIDENCE_ACCOUNT=<your-adls-gen2-account>     # ADLS Gen2 (HNS) telemetry lake
DEEPRCA_EVIDENCE_FS=telemetry
DEEPRCA_STATE_ACCOUNT=<your-blob-account>             # Blob account for the ledger
DEEPRCA_STATE_CONTAINER=investigations
DEEPRCA_MODEL_ENDPOINT=https://<your-foundry>.openai.azure.com/
DEEPRCA_MODEL_API_VERSION=preview                     # 'preview' enables the Responses API
DEEPRCA_INVESTIGATOR_DEPLOYMENT=gpt-4.1
DEEPRCA_EVALUATOR_DEPLOYMENT=gpt-4.1
DEEPRCA_GT_ACCOUNT=<your-isolated-gt-account>         # offline eval plane only
DEEPRCA_CASE=batch-01KQHDBB5Y8K69Z13G7VSWG9FS
